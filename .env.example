# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked into the app at build time: redeploy after changing them.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key
SUPABASE_SECRET_KEY=sb_secret_xxx                         # or the legacy service_role key. Server only!

# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-with-openssl-rand-hex-32

# Web Push: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: your deployed URL, included in the feed reader's User-Agent so site owners can see who's fetching.
NEXT_PUBLIC_APP_URL=https://comper.vercel.app
